{
  "name": "ffrwd/faceage",
  "version": "0.3.0",
  "description": "Ages on the faces ffrwd/rfdetr finds, for blurring the children in a video and nobody else: one row per face with an age, followed across frames and named by when it was first seen. The weights are TrungTran's FaceAge ClientScan (Apache-2.0, built with DINOv3), fetched at install.",
  "license": "Apache-2.0",
  "homepage": "https://github.com/imbcmdth/ffrwd-package-faceage",
  "ffrwd": ">=0.30.0",
  "capabilities": [
    "nn"
  ],
  "dependencies": {
    "ffrwd/wasm": "0.19.1",
    "ffrwd/rfdetr": "0.5.0",
    "ffrwd/mask_tools": "1.3.0"
  },
  "keywords": [
    "face",
    "age",
    "children",
    "minors",
    "blur",
    "mosaic",
    "privacy",
    "nn"
  ],
  "lib": {
    "ages": "src/model.sql",
    "ages_gpu": "src/model.sql"
  },
  "bin": {
    "blur-children": "recipes/blur-children.sql",
    "mosaic-children": "recipes/mosaic-children.sql",
    "ages": "recipes/ages.sql",
    "blur-children-gpu": "recipes/blur-children-gpu.sql",
    "mosaic-children-gpu": "recipes/mosaic-children-gpu.sql"
  },
  "models": {
    "ages": {
      "repo": "imbcmdth/faceage-onnx",
      "revision": "c795238c86f26fc5d9b321c8a6df1d35613f5346",
      "file": "faceage-dino-vitl16-fused-fp16.onnx",
      "sha256": "30c5531f17a1faa1f27891cb8af3e12f1fb14ea5f456192d0f1afcc8c9105ba0",
      "not_on": ["directml"]
    }
  }
}
